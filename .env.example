# ---------- Database (required) ----------
# Supabase Postgres connection string (Session pooler URI). See SUPABASE.md.
DATABASE_URL=

# ---------- Security / login ----------
# Secret used to sign login tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
# Default account passwords, created on first run (change after first login).
ADMIN_PASSWORD=gtms-admin
GUARD_PASSWORD=gtms-guard

# ---------- Server ----------
PORT=3000

# ---------- Email (Nodemailer) ----------
# Leave SMTP_* blank for DEMO mode (preview links in the terminal).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="GTMS Security <gtms@yourcompany.com>"

# ---------- Defaults ----------
DEFAULT_REPORT_TIME=07:00
DEFAULT_MANAGER_EMAIL=security.manager@company.com
