# ---------- Database (required) ----------
# Your Supabase Postgres connection string. See SUPABASE.md for how to get it.
# Use the "Session pooler" URI from Supabase (works from any host, IPv4).
# Example: postgresql://postgres.abcd:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_URL=

# ---------- Server ----------
PORT=3000

# ---------- Email (Nodemailer) ----------
# Leave SMTP_* blank for DEMO mode: emails go to an auto-created Ethereal inbox
# and a preview link is printed in the terminal. Fill these to send real email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="GTMS Security <gtms@yourcompany.com>"

# ---------- Defaults (used before you change them in the app) ----------
DEFAULT_REPORT_TIME=07:00
DEFAULT_MANAGER_EMAIL=security.manager@company.com
